# Copy to .env and adjust values as needed.

# --- Shared by cmd/telemetry-server and cmd/relay ---

# Mandatory for both binaries: Kafka bootstrap broker addresses (comma-separated).
# KAFKA_BROKERS=localhost:9092

# Optional: Kafka topic name. Default: telemetry.raw
# KAFKA_TOPIC=telemetry.raw

# Optional: application environment. Default: development
# Use "production" (case-insensitive) to default logs to JSON; other values default to text.
APP_ENV=development

# Optional: log level. Default: info
# Allowed values: debug, info, warn, error (case-insensitive)
LOG_LEVEL=info

# Optional: log format. Default: derived from APP_ENV (production => json, otherwise text)
# Allowed values: json, text (case-insensitive)
# LOG_FORMAT=text

# --- Telemetry server (cmd/telemetry-server) ---

# Optional: HTTP listen address. Default: :8080
HTTP_ADDR=:8080

# --- Relay (cmd/relay) ---

# Optional: WebSocket listen address for device connections. Default: :9000
# The ingest path is fixed at /telemetry, e.g. ws://localhost:9000/telemetry
# WS_ADDR=:9000

# --- Device simulator (make device, also used by docker compose) ---

# Optional: WebSocket endpoint the device simulator connects to.
# Default: ws://localhost:9000/telemetry
# Set to ws://telemetry-relay:9000/telemetry when running against compose.
# WS_URL=ws://localhost:9000/telemetry
