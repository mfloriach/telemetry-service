# Copy to .env and adjust values as needed.

# Mandatory: upstream WebSocket telemetry source URL.
TELEMETRY_WS_URL=ws://localhost:9000/telemetry

# Optional: HTTP listen address. Default: :8080
HTTP_ADDR=:8080

# Optional: application environment. Default: development
# Use "production" (case-insensitive) to default logs to JSON; other values default to text.
APP_ENV=development

# Optional: log level. Default: info
# Allowed values: debug, info, warn, error (case-insensitive)
LOG_LEVEL=info

# Optional: log format. Default: derived from APP_ENV (production => json, otherwise text)
# Allowed values: json, text (case-insensitive)
# LOG_FORMAT=text
